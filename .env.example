HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Required by docker-compose.prod.yaml; DNS must point this host to the server.
APP_DOMAIN=events.example.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_TIMEOUT=10s
# Use verify-full and set a CA file outside local development.
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_ROOT_CERT=

LOGGER_LEVEL=DEBUG
# Required only for direct go run; Make and Docker provide these paths.
LOGGER_FOLDER=../out/logs
PROJECT_ROOT=.

TIME_ZONE=UTC

AUTH_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_TOKEN_ISSUER=eventsapp
AUTH_TOKEN_AUDIENCE=eventsapp-web
AUTH_REFRESH_COOKIE_NAME=eventsapp_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
# false is for local HTTP only; production HTTPS must use true.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=strict
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m
# Comma-separated exact IPs/CIDRs of immediate controlled proxies.
# Empty is the safe default for direct local runs. Compose injects only its
# stable Nginx address (172.31.254.2/32).
AUTH_RATE_LIMIT_TRUSTED_PROXIES=
